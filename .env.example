# Server
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=
MAX_JSON_BYTES=2097152
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MIN=120
NATURALIZER_STATE_DIR=state
NATURALIZER_PLAN=free

# StealthGPT Humanizer API (Optional)
# Add your StealthGPT API token here or in .env.local to enable StealthGPT rewriting:
STEALTHGPT_API_KEY=
STEALTHGPT_BASE_URL=https://www.stealthgpt.ai/api/stealthify
STEALTHGPT_MODEL=heavy # options: heavy, lite

